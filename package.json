{
  "name": "opencode-clinepass-provider",
  "version": "0.1.0",
  "description": "ClinePass provider plugin for Opencode — authenticate via Cline Pass (Cline CLI subscription or static API key) and use 10 curated open-weight coding models through Cline's OpenAI-compatible API.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cline",
    "clinepass",
    "cline-pass",
    "provider",
    "llm",
    "ai",
    "deepseek",
    "glm",
    "kimi",
    "qwen"
  ],
  "license": "MIT",
  "author": "Tony",
  "type": "module",
  "main": "src/clinepass.ts",
  "types": "src/clinepass.ts",
  "exports": {
    ".": "./src/clinepass.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "fmt": "oxfmt src/ tests/",
    "fmt:check": "oxfmt --check src/ tests/",
    "konsistent": "konsistent",
    "lint": "oxlint src/ tests/",
    "lint:fix": "oxlint --fix src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.13",
    "@opencode-ai/sdk": "^1.17.13",
    "@types/node": "^22.10.0",
    "konsistent": "^1.0.0-beta.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
